io.println(True and 1)    // 1
io.println(False and 1)   // False
io.println(-1 and True)   // True
io.println(-1 and False)  // False
io.println(True and "ok") // "ok"
io.println("" and "ok")   // "ok"

io.println(True or 1)     // True
io.println(False or 1)    // 1
io.println(-1 or True)    // -1
io.println(-1 or False)   // -1
io.println(False or "ok") // "ok"
io.println("" or "bad")   // ""

if (not None) {
  io.println(None and "bad") // None
  io.println(None or "ok")   // "ok"
}
