#!/usr/bin/env ruby
require 'taoism'

source = if $stdin.tty?
  files = ARGV.reject { _1.start_with?('-') }

  if files.empty?
    puts "Tao is a toy language."
    exit 0
  end

  filepath = files.first

  if files[1]
    $stderr.puts "skipped: #{files[1..].join(', ')}"
  end

  if File.exist?(filepath)
    File.read(filepath)
  else
    $stderr.puts "No such file - #{filepath}"
    exit 1
  end
else
  ARGF.read
end

lexer = Taoism::Lexer.new(source)
parser = Taoism::Parser.new(lexer)

ast = parser.parse

if parser.errors.empty?
  evaluator = Taoism::Evaluator.new
  begin
    evaluator.evaluate(ast)
  rescue Runtime::Error => err
    $stderr.puts "Error: #{err.message}"
    exit 1
  end
else
  parser.errors.each { |e| $stderr.puts e }
  exit 1
end
