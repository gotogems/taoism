---
import { home } from '../i18n'
const t = home
---

<section class="mx-auto max-w-5xl px-6 py-24 text-center">
  <p class="eyebrow">Philosophy</p>
  <h2 class="mt-2 font-serif text-3xl font-extralight tracking-tight">{t.philosophy.title}</h2>
  <blockquote class="mx-auto mt-10 max-w-3xl font-serif text-2xl leading-relaxed text-base-content/80 sm:text-3xl">
    {t.hero.quote}
  </blockquote>
  <p class="mx-auto mt-6 max-w-xl text-sm text-base-content/50">{t.hero.note}</p>
  <blockquote class="mx-auto mt-10 max-w-2xl font-serif text-xl leading-relaxed text-base-content/70">
    {t.philosophy.quote}
  </blockquote>
  <p class="mx-auto mt-6 max-w-xl text-sm text-base-content/50">{t.philosophy.note}</p>
</section>