---
import { home, sampleCode } from '../i18n'
import { Code } from 'astro/components'
const t = home
---

<section class="mx-auto max-w-5xl px-6 py-16">
  <p class="eyebrow">Quickstart</p>
  <h2 class="mt-2 font-serif text-3xl font-extralight tracking-tight">{t.quickstart.title}</h2>
  <div class="mt-8 grid gap-6 md:grid-cols-3">
    {t.quickstart.steps.map((s, i) => (
      <div class="rounded-xl border border-base-300 bg-base-100 p-6">
        <p class="font-mono text-xs text-base-content/40">Step 0{i + 1}</p>
        <code class="mt-3 block font-mono text-sm">{s.cmd}</code>
        <p class="mt-2 text-sm text-base-content/50">{s.desc}</p>
      </div>
    ))}
  </div>
  <figure class="mt-8 overflow-hidden rounded-xl border border-dashed border-base-300 bg-base-100 text-base-content">
    <figcaption class="flex items-center justify-between gap-3 border-b border-base-300 px-4 py-2 text-xs text-base-content/50">
      <span class="font-mono">{t.quickstart.codeTitle}</span>
      <button id="copy-sample" type="button" class="btn btn-ghost btn-xs">Copy</button>
    </figcaption>
    <Code
      code={sampleCode}
      lang="kts"
      themes={{ light: 'min-light' }}
      defaultColor={false}
      id="sample-code"
      class="overflow-x-auto p-5 text-sm leading-relaxed"
    />
  </figure>
</section>

<script is:inline>
  const copyBtn = document.getElementById("copy-sample")
  const sampleCode = document.getElementById("sample-code")
  if (copyBtn && sampleCode) {
    copyBtn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(sampleCode.textContent ?? "")
        copyBtn.textContent = "Copied"
        setTimeout(() => (copyBtn.textContent = "Copy"), 2000)
      } catch {
        /* clipboard unavailable */
      }
    })
  }
</script>