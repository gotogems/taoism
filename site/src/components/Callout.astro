---
interface Props {
  kind?: 'warn'
}

const { kind } = Astro.props
---

<div
  class:list={[
    'callout not-prose mt-6 rounded-xl border p-5 text-sm leading-relaxed text-base-content/80',
    kind === 'warn'
      ? 'border-warning/60 border-l-4 border-l-warning bg-warning/5'
      : 'border-base-300 bg-base-100',
  ]}
>
  <slot />
</div>
