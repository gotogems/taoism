---
import Logo from './Logo.astro'

interface Props {
  links: { href: string; label: string }[]
  active?: string
}

const { links, active } = Astro.props
const isActive = (href: string) => active === href
---

<header class="navbar sticky top-0 z-10 border-b border-base-300 bg-base-100/90 backdrop-blur">
  <div class="navbar-start">
    <Logo />
  </div>
  <div class="navbar-end">
    <nav aria-label="Primary" class="hidden gap-1 md:flex">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={['btn btn-ghost btn-sm', isActive(l.href) && 'btn-active']}
        >
          {l.label}
        </a>
      ))}
    </nav>
    <nav aria-label="Primary" class="dropdown dropdown-end md:hidden">
      <button type="button" class="btn btn-ghost btn-sm" aria-label="Menu">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
      <ul
        tabindex="0"
        class="dropdown-content menu menu-sm z-50 mt-2 w-48 rounded-box border border-base-300 bg-base-100 p-2 shadow"
      >
        {links.map((l) => (
          <li>
            <a href={l.href} class:list={[isActive(l.href) && 'menu-active']}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>